# ==============================================================================
# Neo4j Target Configuration
# ==============================================================================
# Aura Free / Professional: neo4j+s://<dbid>.databases.neo4j.io
# Aura Virtual Dedicated Cloud (VDC): neo4j+s://<custom-endpoint>.databases.neo4j.io
# Local Neo4j Desktop / Enterprise: neo4j://localhost:7687 or bolt://localhost:7687
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ==============================================================================
# Snowflake Source Configuration
# ==============================================================================
# Account identifier format: <orgname>-<accountname> or <account_locator>.<region>
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=workshop_user
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN

# Target database & schema:
# Public workshop default: SNOWFLAKE_SAMPLE_DATA / TPCH_SF1
# Custom enterprise default: YOUR_DB / YOUR_SCHEMA
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1

# Authentication Method (Choose ONE):
# Option A: Temporary Programmatic Access Token (bypasses missing network policy)
SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_TOKEN=your-temporary-token

# Option B: Standard Password (if allowed by account/non-MFA)
# SNOWFLAKE_PASSWORD=your-password

# Optional: Value sampling controls (set to 0 if table-level SELECT is restricted)
SNOWFLAKE_VALUE_SAMPLE_LIMIT=10

# ==============================================================================
# LLM Provider Configuration (Choose ONE Option)
# ==============================================================================
# AGENT_MODEL is only used by the workshop Text2SQL agent (`workshop-agent`).
# EMBEDDING_MODEL is used by `neocarta ... --embeddings` and the MCP server.
# If you change EMBEDDING_MODEL after ingesting, re-run ingestion with embeddings
# so stored vectors and query vectors come from the same model.

# Option 1: Public API (Default)
AGENT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=your-openai-key

# Option 1b: Anthropic chat + local embeddings
# Anthropic has no embedding model, so pair Claude (agent) with Ollama (embeddings).
# Do NOT set OPENAI_BASE_URL to Anthropic's endpoint; LiteLLM talks to Anthropic natively.
# ANTHROPIC_API_KEY=your-anthropic-key
# AGENT_MODEL=anthropic/claude-haiku-4-5
# OLLAMA_API_BASE=http://localhost:11434
# EMBEDDING_MODEL=ollama/nomic-embed-text

# Option 2: Local Inference via Ollama
# Requires a tool-calling capable chat model and compatible embeddings
# OLLAMA_API_BASE=http://localhost:11434
# AGENT_MODEL=ollama/qwen2.5:7b
# EMBEDDING_MODEL=ollama/nomic-embed-text

# Option 3: Corporate API Gateway (Standard Proxy)
# OPENAI_BASE_URL=https://your-corporate-gateway.com/v1
# OPENAI_API_KEY=your-internal-key
# AGENT_MODEL=openai/your-internal-model-name
# EMBEDDING_MODEL=openai/your-internal-embedding-model

# Option 3b: Corporate Gateway requiring custom HTTP headers
# See docs/attendee_guide.md ("LLM Execution Environments & Fallbacks") for the
# AI prompt that patches Neocarta to send these headers.
# CORPORATE_GATEWAY_HEADERS='{"Ocp-Apim-Subscription-Key": "your-key", "X-Custom-Auth": "token"}'

# Optional: max rows the workshop agent's execute_sql returns (default 50)
# AGENT_ROW_LIMIT=50

# ==============================================================================
# Optional: Neo4j MCP server for your coding agent (.mcp.json)
# ==============================================================================
# Only needed if you want Claude Code (or another MCP client) to query the graph
# through the official neo4j-mcp-server. Same values as the NEO4J_* block above.
# NEO4J_MCP_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_MCP_USERNAME=neo4j
# NEO4J_MCP_PASSWORD=your-neo4j-password
